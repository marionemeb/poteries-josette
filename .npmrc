# Config npm propre à ce repo — passe outre le ~/.npmrc global de la machine
# (hérité d'un autre projet/emploi), qui définit ignore-scripts=true et un
# registre privé par défaut. Sans ça, node-sass ne peut pas télécharger son
# binaire précompilé (postinstall ignoré), et les paquets publics seraient
# cherchés sur un registre interne sans rapport avec ce projet.
ignore-scripts=false
registry=https://registry.npmjs.org/

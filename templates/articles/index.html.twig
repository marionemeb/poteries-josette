{% extends 'base.html.twig' %}

{% block title %}Mes poteries{% endblock %}

{% block body_class %}articles-page{% endblock %}

{% block body %}
    <div class="container-fluid articles">
        <div class="container">
        <div class="articles-title">Mes poteries</div>
        <section class="card-columns">
            {% for product in products %}
                <div class="card">
                    <img class="card-img-top" src="{{ ('/uploads/images/products/'~product.name) }}" alt="{{ product.title }}" onerror="this.closest('.card').remove()" onclick="document.getElementById('image-lightbox-img').src=this.src; document.getElementById('image-lightbox').classList.add('open');">
                    {% if product.title or product.description %}
                        <div class="card-body">
                            {% if product.title %}
                                <h2 class="card-title">{{ product.title }}</h2>
                            {% endif %}
                            {% if product.description %}
                                <p class="card-text">{{ product.description }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </section>
        </div>
    </div>

    {# Click a product photo to see it uncropped at its original size. #}
    <div id="image-lightbox" class="image-lightbox" onclick="this.classList.remove('open')">
        <img id="image-lightbox-img" src="" alt="">
    </div>
{% endblock %}

<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {# Plain root-relative paths on purpose, not asset(): these files never
           need cache-busting, and asset() requires public/build/manifest.json
           to exist — which it doesn't in the CI phpunit job (only the separate
           frontend-build job runs npm run build), so it threw a fatal error on
           every single page render there (base.html.twig is always included). #}
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        {# "Add to home screen": name, icon and colors used by the phone's shortcut. #}
        <link rel="manifest" href="/site.webmanifest">
        <meta name="theme-color" content="#222424">
        <meta name="apple-mobile-web-app-title" content="Poteries Josette">
        <script src="https://kit.fontawesome.com/ab15670bb2.js" crossorigin="anonymous"></script>
        <title>{% block title %}Bienvenue{% endblock %}</title>

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            {{ encore_entry_link_tags('articles') }}
            {{ encore_entry_link_tags('event') }}
            {{ encore_entry_link_tags('navbar') }}
            {{ encore_entry_link_tags('recipes') }}
            {{ encore_entry_link_tags('login') }}
        {% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
    {% include '_navbar.html.twig' %}
        {% block body %}{% endblock %}
    {% include '_footer.html.twig' %}
        <button id="back-to-top" class="back-to-top" aria-label="Remonter en haut de la page">
            <i class="fas fa-arrow-up"></i>
        </button>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {{ encore_entry_script_tags('index') }}
        {% endblock %}
    </body>
</html>

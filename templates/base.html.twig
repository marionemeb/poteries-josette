<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="">
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="48x48" href="{{ asset('favicon-48x48.png') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('favicon-96x96.png') }}">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('favicon-192x192.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <script src="https://kit.fontawesome.com/ab15670bb2.js" crossorigin="anonymous"></script>
        <title>{% block title %}Bienvenue{% endblock %}</title>

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
            {{ encore_entry_link_tags('articles') }}
            {{ encore_entry_link_tags('event') }}
            {{ encore_entry_link_tags('navbar') }}
            {{ encore_entry_link_tags('recipes') }}
            {{ encore_entry_link_tags('login') }}
        {% endblock %}
    </head>
    <body>
    {% include '_navbar.html.twig' %}
        {% block body %}{% endblock %}
    {% include '_footer.html.twig' %}
        <button id="back-to-top" class="back-to-top" aria-label="Remonter en haut de la page">
            <i class="fas fa-arrow-up"></i>
        </button>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {{ encore_entry_script_tags('index') }}
        {% endblock %}
    </body>
</html>

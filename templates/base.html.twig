<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="{% block description %}Les Poteries de Josette : poteries utilitaires et décoratives en terre vernissée, façonnées dans son atelier d’Oingt, en Beaujolais.{% endblock %}">
        {# Plain root-relative paths on purpose, not asset(): these files never
           need cache-busting, and asset() requires public/build/manifest.json
           to exist — which it doesn't in the CI phpunit job (only the separate
           frontend-build job runs npm run build), so it threw a fatal error on
           every single page render there (base.html.twig is always included). #}
        <link rel="icon" href="/favicon.ico" sizes="any">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        {# "Add to home screen": name, icon and colors used by the phone's shortcut. #}
        <link rel="manifest" href="/site.webmanifest">
        <meta name="theme-color" content="#222424">
        <meta name="apple-mobile-web-app-title" content="Poteries Josette">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courgette&family=Open+Sans:wght@400;600;700&display=swap">
        <title>{% block title %}Bienvenue{% endblock %}{% block title_suffix %} · Les Poteries de Josette{% endblock %}</title>
        {# One address per page for search engines: the category filters
           (?search…) would otherwise look like duplicate pages. #}
        <link rel="canonical" href="{{ site_url ~ app.request.pathInfo }}">
        {% block robots %}{% endblock %}
        {# Link preview when the page is shared (Facebook, WhatsApp, Messages…):
           title and description of the page, plus a 1200×630 crop of its
           photo (public/img/share/, the home page's for the other pages). #}
        {% set share_images = {
            home: 'Bouquet de coquelicots en céramique rouge de Josette',
            articles: 'Bols en terre vernissée de Josette',
            work: 'Mains de potière façonnant un bol au tour',
            shop: 'Vue aérienne du village d’Oingt, en Beaujolais',
            events: 'Pichets et plats de Josette sur un marché',
            recipes: 'Légumes et pâtes sur une table en bois',
            blog: 'Plat en forme de cœur émaillé rouge',
        } %}
        {% set share_page = app.request.attributes.get('_route') in share_images|keys ? app.request.attributes.get('_route') : 'home' %}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Les Poteries de Josette">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ (block('title') ~ block('title_suffix'))|striptags|trim }}">
        <meta property="og:description" content="{{ block('description')|striptags|trim }}">
        <meta property="og:url" content="{{ site_url ~ app.request.pathInfo }}">
        <meta property="og:image" content="{{ site_url }}/img/share/{{ share_page }}.jpg">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ share_images[share_page] }}">
        <meta name="twitter:card" content="summary_large_image">
        {% block head_extra %}{% endblock %}

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="page-{{ app.request.attributes.get('_route')|default('error') }}">
    {% include '_navbar.html.twig' %}
        {% block body %}{% endblock %}
    {% include '_footer.html.twig' %}
        {% import '_icons.html.twig' as icon %}
        <button id="back-to-top" class="back-to-top" aria-label="Remonter en haut de la page">
            {{ icon.svg('arrow-up', 20) }}
        </button>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {{ encore_entry_script_tags('index') }}
        {% endblock %}
    </body>
</html>

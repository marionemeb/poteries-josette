{# Address, phone and e-mail of the workshop, plus "Itinéraire"/"Appeler"
   buttons. Shared by the home page and /shop; `dark` switches the buttons
   to their light-on-dark version. #}
{% import '_icons.html.twig' as icon %}
{% set maps_url = 'https://www.google.com/maps/search/?api=1&query=Rue+Tyre-Laine+69620+Oingt' %}
<ul class="visit-list">
    <li>{{ icon.svg('pin', 22) }}<a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer">Rue Tyre-Laine<br>69620 Oingt</a></li>
    <li>{{ icon.svg('phone', 22) }}<a href="tel:+33474711173">04 74 71 11 73</a></li>
    <li>{{ icon.svg('mail', 22) }}<a href="mailto:josette.bourgogne@wanadoo.fr">josette.bourgogne@<wbr>wanadoo.fr</a></li>
</ul>
<div class="visit-actions">
    <a class="btn-all {{ dark|default(false) ? 'btn-light-solid' : 'btn-dark-solid' }}" href="{{ maps_url }}" target="_blank" rel="noopener noreferrer">Itinéraire</a>
    <a class="btn-all {{ dark|default(false) ? 'btn-light-outline' : 'btn-dark-outline' }}" href="tel:+33474711173">{{ call_label|default('Appeler Josette') }}</a>
</div>

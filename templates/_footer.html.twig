{% set maps_url = 'https://www.google.com/maps/search/?api=1&query=Rue+Tyre-Laine+69620+Oingt' %}
<div class="pt-5 pb-3 footer">
    <div class="container">
        <div class="row">
            <div class="col-lg-5 col-xs-12 about-company">
                <a href="{{ path('home') }}"><h2>Les Poteries de Josette</h2></a>
                <p class="text-white-50"><a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer">OINGT en
                    BEAUJOLAIS</a>,<br>
                    classé un des plus beaux villages de France</p>
                <p class="social">
                    <a href="https://www.facebook.com/lespoteriesdejosette" target="_blank" rel="noopener noreferrer" aria-label="Facebook des Poteries de Josette" title="Facebook"><i class="fab fa-facebook-square" aria-hidden="true"></i></a>
                    <a href="https://www.instagram.com/les_poteries_de_josette/" target="_blank" rel="noopener noreferrer" aria-label="Instagram des Poteries de Josette" title="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>
                </p>
            </div>
            <div class="col-lg-3 col-xs-12 links">
                <h4 class="mt-4 mt-lg-0">Liens</h4>
                <ul class="m-0 p-0">
                    <li><a href="{{ path('articles') }}">Poteries</a></li>
                    <li><a href="{{ path('work') }}">Argile et émaux</a></li>
                    <li><a href="{{ path('shop') }}">Atelier</a></li>
                    {% if has_upcoming_events() %}
                        <li><a href="{{ path('events') }}">Evènements</a></li>
                    {% endif %}
                    {% if has_recipes() %}
                        <li><a href="{{ path('recipes') }}">Recettes de Josette</a></li>
                    {% endif %}
                    {% if has_blog_articles() %}
                        <li><a href="{{ path('blog') }}">Coups de coeur</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-lg-4 col-xs-12 location">
                <h4 class="mt-4 mt-lg-0">Adresse</h4>
                <p><a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer" class="text-white-50">Rue Tyre-Laine<br>
                    69620 OINGT - FRANCE</a>
                </p>
                <p class="mb-0"><i class="fas fa-phone mr-3" aria-hidden="true"></i>Tel : <a href="tel:+33474711173">04 74 71 11 73</a></p>
                <p><i class="far fa-envelope mr-3" aria-hidden="true"></i><a href="mailto:josette.bourgogne@wanadoo.fr">josette.bourgogne@wanadoo.fr</a></p>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col copyright">
                {# On phones the two groups stack instead of wrapping mid-link. #}
                <p><small class="text-white-50"><span class="text-nowrap">© {{ 'now'|date('Y') }} Les Poteries de Josette</span><span class="separator d-none d-sm-inline" aria-hidden="true">·</span><span class="d-block d-sm-inline text-nowrap"><a href="{{ path('legalMentions') }}">Mentions légales</a><span class="separator" aria-hidden="true">·</span><a href="{{ path('admin') }}" class="admin-link" aria-label="Administration" title="Administration"><i class="fas fa-lock" aria-hidden="true"></i></a></span></small></p>
            </div>
        </div>
    </div>
</div>

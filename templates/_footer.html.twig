{% import '_icons.html.twig' as icon %}
{% set maps_url = 'https://www.google.com/maps/search/?api=1&query=Rue+Tyre-Laine+69620+Oingt' %}
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-columns">
            <div class="footer-about">
                <a class="footer-brand" href="{{ path('home') }}">Les Poteries de Josette</a>
                <p><a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer">Oingt en Beaujolais</a>,<br>
                    classé un des plus beaux villages de France</p>
                <p class="social">
                    <a href="https://www.facebook.com/lespoteriesdejosette" target="_blank" rel="noopener noreferrer" aria-label="Facebook des Poteries de Josette" title="Facebook">{{ icon.svg('facebook', 18) }}</a>
                    <a href="https://www.instagram.com/les_poteries_de_josette/" target="_blank" rel="noopener noreferrer" aria-label="Instagram des Poteries de Josette" title="Instagram">{{ icon.svg('instagram', 18) }}</a>
                </p>
            </div>
            <div class="footer-links">
                <h4>Liens</h4>
                <ul>
                    <li><a href="{{ path('articles') }}">Poteries</a></li>
                    <li><a href="{{ path('work') }}">Argile et émaux</a></li>
                    <li><a href="{{ path('shop') }}">Atelier</a></li>
                    {% if has_upcoming_events() %}
                        <li><a href="{{ path('events') }}">Évènements</a></li>
                    {% endif %}
                    {% if has_recipes() %}
                        <li><a href="{{ path('recipes') }}">Recettes de Josette</a></li>
                    {% endif %}
                    {% if has_blog_articles() %}
                        <li><a href="{{ path('blog') }}">Coups de cœur</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="footer-contact">
                <h4>Adresse</h4>
                <ul>
                    <li><a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer" class="footer-address">Rue Tyre-Laine<br>69620 OINGT - FRANCE</a></li>
                    <li><a href="tel:+33474711173">04 74 71 11 73</a></li>
                    <li><a href="mailto:josette.bourgogne@wanadoo.fr">josette.bourgogne@wanadoo.fr</a></li>
                </ul>
            </div>
        </div>
        <div class="copyright">
            <span>© {{ 'now'|date('Y') }} Les Poteries de Josette</span>
            <span class="separator d-none d-sm-inline" aria-hidden="true">·</span>
            {# Kept together so the lock never ends up alone on a line. #}
            <span class="text-nowrap">
                <a href="{{ path('legalMentions') }}">Mentions légales</a>
                <span class="separator" aria-hidden="true">·</span>
                <a href="{{ path('admin') }}" class="admin-link" aria-label="Administration" title="Administration">{{ icon.svg('lock', 13) }}</a>
            </span>
        </div>
    </div>
</footer>

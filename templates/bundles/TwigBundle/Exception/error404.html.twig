{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
    <main class="page-hero error-page" id="contenu">
        <h1 class="page-title">Page introuvable</h1>
        <p class="page-lead">
            Cette page n'existe pas, ou elle a été déplacée.<br>
            Les poteries, elles, sont toujours là !
        </p>
        <div class="error-page-actions">
            <a class="btn-all btn-light-solid" href="{{ path('home') }}">Retour à l'accueil</a>
            <a class="btn-all btn-light-outline" href="{{ path('articles') }}">Voir les poteries</a>
        </div>
    </main>
{% endblock %}

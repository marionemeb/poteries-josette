{# Inline stroke icons, so the site no longer depends on the Font Awesome kit.
   Usage: {% import '_icons.html.twig' as icon %} … {{ icon.svg('phone') }} #}
{% macro svg(name, size = 20) %}
    {%- set paths = {
        'pin': '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
        'phone': '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
        'mail': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
        'calendar': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
        'print': '<path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="7"/>',
        'close': '<path d="M6 6l12 12M18 6L6 18"/>',
        'chevron-left': '<path d="M15 6l-6 6 6 6"/>',
        'chevron-right': '<path d="M9 6l6 6-6 6"/>',
        'chevron-down': '<path d="M6 9l6 6 6-6"/>',
        'arrow-up': '<path d="M12 19V5M5 12l7-7 7 7"/>',
        'check': '<path d="M5 12l5 5 9-10"/>',
        'lock': '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
        'facebook': '<path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z"/>',
        'instagram': '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5"/>',
        'pot': '<path d="M7 3h10l-1 4a6 6 0 0 1 3 5v4a5 5 0 0 1-5 5h-4a5 5 0 0 1-5-5v-4a6 6 0 0 1 3-5z"/>',
        'oven': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h8"/>',
        'drop': '<path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"/>',
    } -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name]|raw }}</svg>
{%- endmacro %}

{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icon %}
{% import 'events/_dates.html.twig' as dates %}

{% block title %}Mes évènements{% endblock %}

{% block body %}
    <section class="page-hero page-hero--events">
        <h1 class="page-title">Les évènements de Josette</h1>
        <p class="page-lead">Marchés, expositions et portes ouvertes où retrouver Josette et ses poteries.</p>
    </section>

    <main class="page-content page-content--medium" id="contenu">
        {% if events is empty %}
            <p class="empty-state">Aucun évènement prévu pour le moment. <a href="{{ path('shop') }}">L’atelier vous accueille toute l’année</a>.</p>
        {% else %}
            <div class="event-list">
                {% for event in events %}
                    {% set tag = event.link ? 'a' : 'article' %}
                    <{{ tag }} class="tile-card event-card"{% if event.link %} href="{{ event.link }}" target="_blank" rel="noopener noreferrer"{% endif %}>
                        <div class="event-card-media">
                            {% if event.imageName %}
                                <img src="{{ '/uploads/images/products/' ~ event.imageName }}" alt="" loading="lazy" onerror="this.remove()">
                            {% endif %}
                            {{ dates.badge(event.dateStart) }}
                        </div>
                        <div class="event-card-body">
                            <h2 class="tile-card-title">{{ event.title }}</h2>
                            <div class="event-card-meta">
                                <span>{{ icon.svg('calendar', 18) }}{{ dates.range(event.dateStart, event.dateEnd) }}</span>
                                {% if event.location %}
                                    <span>{{ icon.svg('pin', 18) }}{{ event.location }}</span>
                                {% endif %}
                            </div>
                            {% if event.description %}
                                <p class="tile-card-text">{{ event.description }}</p>
                            {% endif %}
                            {% if event.link %}
                                <span class="event-card-more">En savoir plus →</span>
                            {% endif %}
                        </div>
                    </{{ tag }}>
                {% endfor %}
            </div>
        {% endif %}
    </main>
{% endblock %}

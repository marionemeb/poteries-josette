{# Event dates in French, without depending on the intl extension:
   badge() → the "21 / oct." square, range() → "Du 21 au 23 octobre 2026". #}
{% macro badge(date) %}
    {%- set months = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'] -%}
    <span class="date-badge">
        <span class="date-badge-day">{{ date|date('j') }}</span>
        <span class="date-badge-month">{{ months[date|date('n') - 1] }}</span>
    </span>
{%- endmacro %}

{% macro day(date, with_month = true, with_year = true) %}
    {%- set months = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] -%}
    {{- date|date('j') == '1' ? '1er' : date|date('j') -}}
    {%- if with_month %} {{ months[date|date('n') - 1] }}{% endif -%}
    {%- if with_year %} {{ date|date('Y') }}{% endif -%}
{%- endmacro %}

{% macro range(start, end) %}
    {%- import _self as self -%}
    {%- if end is empty or start|date('Y-m-d') == end|date('Y-m-d') -%}
        Le {{ self.day(start) }}
    {%- elseif start|date('Y-m') == end|date('Y-m') -%}
        Du {{ self.day(start, false, false) }} au {{ self.day(end) }}
    {%- elseif start|date('Y') == end|date('Y') -%}
        Du {{ self.day(start, true, false) }} au {{ self.day(end) }}
    {%- else -%}
        Du {{ self.day(start) }} au {{ self.day(end) }}
    {%- endif -%}
{%- endmacro %}
